//
//  Secrets.swift.example
//  Comebackone day 1.2
//
//  Itinerary Plus uses the Google Places API (New) for restaurant ratings and
//  photos, since Apple's MapKit doesn't expose either for arbitrary businesses.
//
//  Setup:
//  1. In the Google Cloud Console (console.cloud.google.com), create a project
//     (or reuse one) and enable billing — Places API (New) has a monthly free
//     credit that covers normal personal use, then pay-as-you-go beyond that.
//  2. In "APIs & Services" > "Library", enable "Places API (New)".
//  3. In "APIs & Services" > "Credentials", create an API key.
//  4. Restrict the key: Application restrictions > iOS apps > bundle ID
//     com.michaeljee.Comebackone-day-1-1. API restrictions > restrict to
//     "Places API (New)".
//  5. Copy this file to Secrets.swift (already gitignored) and paste the key
//     below.
//

enum Secrets {
    static let googlePlacesAPIKey = "YOUR_GOOGLE_PLACES_API_KEY"
}
